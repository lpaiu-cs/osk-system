       {
        "type": "null"
       }
      ]
     },
     "space": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "edges": {
      "anyOf": [
       {
        "additionalProperties": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "items": {
            "type": "string"
           },
           "type": "array"
          }
         ]
        },
        "propertyNames": {
         "enum": [
          "derived-from",
          "conflicts"
